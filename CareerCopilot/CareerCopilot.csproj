<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.12" />
    <PackageReference Include="Telegram.Bot" Version="19.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Fuente única de verdad del CV: se copia a la salida para que Gemini la lea en runtime.
      El perfil no se sube al repo porque tiene datos personales, así que en Render llega como
      secret file y lo apunta BotConfig:CandidateProfileFile. Con la condición, si el archivo no
      está (build de Docker desde un repo sin perfil) la publicación no falla.
    -->
    <Content Include="prompts\profile.md"
             Condition="Exists('prompts\profile.md')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
